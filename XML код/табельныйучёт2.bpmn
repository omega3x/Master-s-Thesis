      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_DataObject_Tabeli" bpmnElement="DataObjectRef_Tabeli">
        <dc:Bounds x="340" y="50" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_DataObject_Bolnichnye" bpmnElement="DataObjectRef_Bolnichnye">
        <dc:Bounds x="420" y="50" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_Start_Record" bpmnElement="Flow_Start_Record">
        <di:waypoint x="248" y="170" />
        <di:waypoint x="300" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Record_Join" bpmnElement="Flow_Record_Join">
        <di:waypoint x="480" y="170" />
        <di:waypoint x="560" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Record_Form" bpmnElement="Flow_Record_Form">
        <di:waypoint x="390" y="210" />
        <di:waypoint x="390" y="350" />
        <di:waypoint x="380" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Form_Join" bpmnElement="Flow_Form_Join">
        <di:waypoint x="470" y="350" />
