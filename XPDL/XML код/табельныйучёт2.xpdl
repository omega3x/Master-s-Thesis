          <Coordinates XCoordinate="880" YCoordinate="350"/>
          <Coordinates XCoordinate="952" YCoordinate="350"/>
        </ConnectorGraphicsInfo>
      </ConnectorGraphicsInfos>
    </Transition>
    </Transitions>
  </WorkflowProcess>
  </WorkflowProcesses>
</Package>
