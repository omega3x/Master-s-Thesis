      <bpmndi:BPMNEdge id="Edge_Flow_Start_Parallel" bpmnElement="Flow_Start_Parallel">
        <di:waypoint x="248" y="165" />
        <di:waypoint x="285" y="165" />
        <di:waypoint x="285" y="380" />
        <di:waypoint x="310" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Split_Debts" bpmnElement="Flow_Split_Debts">
        <di:waypoint x="335" y="355" />
        <di:waypoint x="335" y="335" />
        <di:waypoint x="420" y="335" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Split_Grades" bpmnElement="Flow_Split_Grades">
        <di:waypoint x="335" y="405" />
        <di:waypoint x="335" y="440" />
        <di:waypoint x="420" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Debts_Join" bpmnElement="Flow_Debts_Join">
        <di:waypoint x="590" y="335" />
        <di:waypoint x="655" y="335" />
        <di:waypoint x="655" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Grades_Join" bpmnElement="Flow_Grades_Join">
        <di:waypoint x="590" y="440" />
        <di:waypoint x="655" y="440" />
        <di:waypoint x="655" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Join_Evaluate" bpmnElement="Flow_Join_Evaluate">
        <di:waypoint x="680" y="380" />
        <di:waypoint x="740" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Evaluate_Eligible" bpmnElement="Flow_Evaluate_Eligible">
        <di:waypoint x="920" y="380" />
        <di:waypoint x="960" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Eligible" bpmnElement="Flow_Eligible">
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1008" y="362" width="20" height="14" />
        </bpmndi:BPMNLabel>
        <di:waypoint x="1010" y="380" />
        <di:waypoint x="1080" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_NotEligible" bpmnElement="Flow_NotEligible">
        <bpmndi:BPMNLabel>
          <dc:Bounds x="572" y="248" width="20" height="14" />
        </bpmndi:BPMNLabel>
        <di:waypoint x="985" y="355" />
        <di:waypoint x="985" y="280" />
        <di:waypoint x="560" y="280" />
        <di:waypoint x="560" y="168" />
        <di:waypoint x="640" y="168" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Notify_EndRejected" bpmnElement="Flow_Notify_EndRejected">
        <di:waypoint x="840" y="168" />
        <di:waypoint x="892" y="168" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Chair_ApprovedGW" bpmnElement="Flow_Chair_ApprovedGW">
        <di:waypoint x="1260" y="380" />
        <di:waypoint x="1320" y="380" />
      </bpmndi:BPMNEdge>
