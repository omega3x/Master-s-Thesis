<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_GradDiploma" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="Process_GradDiploma" name="Graduate Diploma Issuance" isExecutable="true">
    <bpmn:laneSet id="LaneSet_GradDiploma">
      <bpmn:lane id="Lane_Student" name="Student Office">
        <bpmn:flowNodeRef>Start_Application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyDeficiencies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Academic" name="Academic Department">
        <bpmn:flowNodeRef>Gateway_ParallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckDebts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PullGrades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChairSign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeanEscalation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_TimerEscalation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Registry" name="Registry and Archive">
        <bpmn:flowNodeRef>Subprocess_Registry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NotifySplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AuditLog</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NotifyJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_DiplomaIssued</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Application" name="Graduation application submitted">
      <bpmn:outgoing>Flow_Start_Parallel</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_ParallelSplit" name="Parallel validation">
      <bpmn:incoming>Flow_Start_Parallel</bpmn:incoming>
      <bpmn:outgoing>Flow_Split_Debts</bpmn:outgoing>
      <bpmn:outgoing>Flow_Split_Grades</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_CheckDebts" name="Verify academic debts in ERP">
      <bpmn:incoming>Flow_Split_Debts</bpmn:incoming>
      <bpmn:outgoing>Flow_Debts_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PullGrades" name="Pull final grades from LMS">
      <bpmn:incoming>Flow_Split_Grades</bpmn:incoming>
      <bpmn:outgoing>Flow_Grades_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_ParallelJoin" name="Validation complete">
      <bpmn:incoming>Flow_Debts_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Grades_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Evaluate</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:businessRuleTask id="Task_EvaluateRequirements" name="Evaluate graduation requirements">
      <bpmn:incoming>Flow_Join_Evaluate</bpmn:incoming>
      <bpmn:outgoing>Flow_Evaluate_Eligible</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Eligible" name="Meets requirements?" default="Flow_NotEligible">
      <bpmn:incoming>Flow_Evaluate_Eligible</bpmn:incoming>
      <bpmn:outgoing>Flow_Eligible</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotEligible</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_NotifyDeficiencies" name="Notify student of deficiencies">
      <bpmn:incoming>Flow_NotEligible</bpmn:incoming>
      <bpmn:incoming>Flow_NotApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_EndRejected</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Rejected" name="Application rejected">
      <bpmn:incoming>Flow_Notify_EndRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_ChairSign" name="Department chair signs transcript">
      <bpmn:incoming>Flow_Eligible</bpmn:incoming>
      <bpmn:outgoing>Flow_Chair_ApprovedGW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_TimerEscalation" name="5-day SLA" attachedToRef="Task_ChairSign" cancelActivity="false">
      <bpmn:outgoing>Flow_Timer_Escalation</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Escalation" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_DeanEscalation" name="Dean reviews escalated case">
      <bpmn:incoming>Flow_Timer_Escalation</bpmn:incoming>
      <bpmn:outgoing>Flow_Dean_ApprovedGW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Approved?" default="Flow_NotApproved">
      <bpmn:incoming>Flow_Chair_ApprovedGW</bpmn:incoming>
      <bpmn:incoming>Flow_Dean_ApprovedGW</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotApproved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Subprocess_Registry" name="Registry processing">
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_Subprocess_NotifySplit</bpmn:outgoing>
      <bpmn:startEvent id="Start_Registry" name="Begin registry">
        <bpmn:outgoing>Flow_Reg_Start_PDF</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_GeneratePDF" name="Generate diploma PDF">
        <bpmn:incoming>Flow_Reg_Start_PDF</bpmn:incoming>
        <bpmn:outgoing>Flow_PDF_Sign</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_DigitalSign" name="Apply qualified digital signature">
        <bpmn:incoming>Flow_PDF_Sign</bpmn:incoming>
        <bpmn:outgoing>Flow_Sign_Archive</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="Task_ArchiveRecord" name="Archive record in document system">
        <bpmn:incoming>Flow_Sign_Archive</bpmn:incoming>
        <bpmn:outgoing>Flow_Archive_EndReg</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="End_Registry" name="Registry complete">
        <bpmn:incoming>Flow_Archive_EndReg</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Reg_Start_PDF" sourceRef="Start_Registry" targetRef="Task_GeneratePDF" />
      <bpmn:sequenceFlow id="Flow_PDF_Sign" sourceRef="Task_GeneratePDF" targetRef="Task_DigitalSign" />
      <bpmn:sequenceFlow id="Flow_Sign_Archive" sourceRef="Task_DigitalSign" targetRef="Task_ArchiveRecord" />
      <bpmn:sequenceFlow id="Flow_Archive_EndReg" sourceRef="Task_ArchiveRecord" targetRef="End_Registry" />
    </bpmn:subProcess>
    <bpmn:parallelGateway id="Gateway_NotifySplit" name="Post-issuance actions">
      <bpmn:incoming>Flow_Subprocess_NotifySplit</bpmn:incoming>
      <bpmn:outgoing>Flow_Split_Notify</bpmn:outgoing>
      <bpmn:outgoing>Flow_Split_Audit</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_SendNotification" name="Send student and dean notifications">
      <bpmn:incoming>Flow_Split_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Task_AuditLog" name="Write immutable audit trail">
      <bpmn:incoming>Flow_Split_Audit</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit_Join</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:parallelGateway id="Gateway_NotifyJoin" name="Actions complete">
      <bpmn:incoming>Flow_Notify_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Audit_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_EndSuccess</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="End_DiplomaIssued" name="Diploma issued">
      <bpmn:incoming>Flow_Join_EndSuccess</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Parallel" sourceRef="Start_Application" targetRef="Gateway_ParallelSplit" />
    <bpmn:sequenceFlow id="Flow_Split_Debts" sourceRef="Gateway_ParallelSplit" targetRef="Task_CheckDebts" />
    <bpmn:sequenceFlow id="Flow_Split_Grades" sourceRef="Gateway_ParallelSplit" targetRef="Task_PullGrades" />
    <bpmn:sequenceFlow id="Flow_Debts_Join" sourceRef="Task_CheckDebts" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_Grades_Join" sourceRef="Task_PullGrades" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_Join_Evaluate" sourceRef="Gateway_ParallelJoin" targetRef="Task_EvaluateRequirements" />
    <bpmn:sequenceFlow id="Flow_Evaluate_Eligible" sourceRef="Task_EvaluateRequirements" targetRef="Gateway_Eligible" />
    <bpmn:sequenceFlow id="Flow_Eligible" name="Yes" sourceRef="Gateway_Eligible" targetRef="Task_ChairSign">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${eligible == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotEligible" name="No" sourceRef="Gateway_Eligible" targetRef="Task_NotifyDeficiencies" />
    <bpmn:sequenceFlow id="Flow_Notify_EndRejected" sourceRef="Task_NotifyDeficiencies" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="Flow_Chair_ApprovedGW" sourceRef="Task_ChairSign" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="Flow_Timer_Escalation" sourceRef="Boundary_TimerEscalation" targetRef="Task_DeanEscalation" />
    <bpmn:sequenceFlow id="Flow_Dean_ApprovedGW" sourceRef="Task_DeanEscalation" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="Flow_Approved" name="Yes" sourceRef="Gateway_Approved" targetRef="Subprocess_Registry">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${approved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotApproved" name="No" sourceRef="Gateway_Approved" targetRef="Task_NotifyDeficiencies" />
    <bpmn:sequenceFlow id="Flow_Subprocess_NotifySplit" sourceRef="Subprocess_Registry" targetRef="Gateway_NotifySplit" />
    <bpmn:sequenceFlow id="Flow_Split_Notify" sourceRef="Gateway_NotifySplit" targetRef="Task_SendNotification" />
    <bpmn:sequenceFlow id="Flow_Split_Audit" sourceRef="Gateway_NotifySplit" targetRef="Task_AuditLog" />
    <bpmn:sequenceFlow id="Flow_Notify_Join" sourceRef="Task_SendNotification" targetRef="Gateway_NotifyJoin" />
    <bpmn:sequenceFlow id="Flow_Audit_Join" sourceRef="Task_AuditLog" targetRef="Gateway_NotifyJoin" />
    <bpmn:sequenceFlow id="Flow_Join_EndSuccess" sourceRef="Gateway_NotifyJoin" targetRef="End_DiplomaIssued" />
    <bpmn:dataObject id="DataObject_Transcript_Def" name="Official transcript" />
    <bpmn:dataObject id="DataObject_Diploma_Def" name="Diploma record" />
    <bpmn:dataObjectReference id="DataObjectRef_Transcript" name="Official transcript" dataObjectRef="DataObject_Transcript_Def" />
    <bpmn:dataObjectReference id="DataObjectRef_Diploma" name="Diploma record" dataObjectRef="DataObject_Diploma_Def" />
    <bpmn:association id="Association_Transcript" associationDirection="None" sourceRef="DataObjectRef_Transcript" targetRef="Task_ChairSign" />
    <bpmn:association id="Association_Diploma" associationDirection="None" sourceRef="DataObjectRef_Diploma" targetRef="Subprocess_Registry" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_GradDiploma">
    <bpmndi:BPMNPlane id="Plane_GradDiploma" bpmnElement="Process_GradDiploma">
      <bpmndi:BPMNShape id="Shape_Lane_Student" bpmnElement="Lane_Student" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2480" height="170" />
