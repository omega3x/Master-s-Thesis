      <bpmndi:BPMNShape id="Shape_Task_EvaluateRequirements" bpmnElement="Task_EvaluateRequirements">
        <dc:Bounds x="740" y="340" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Eligible" bpmnElement="Gateway_Eligible" isMarkerVisible="true">
