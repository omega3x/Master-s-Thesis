        <dc:Bounds x="1660" y="590" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ArchiveRecord" bpmnElement="Task_ArchiveRecord">
        <dc:Bounds x="1800" y="590" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Registry" bpmnElement="End_Registry">
        <dc:Bounds x="1940" y="612" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_NotifySplit" bpmnElement="Gateway_NotifySplit">
        <dc:Bounds x="2000" y="605" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1962" y="662" width="126" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SendNotification" bpmnElement="Task_SendNotification">
        <dc:Bounds x="2100" y="555" width="190" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_AuditLog" bpmnElement="Task_AuditLog">
        <dc:Bounds x="2100" y="660" width="190" height="80" />
      </bpmndi:BPMNShape>
