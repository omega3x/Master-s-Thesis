      <bpmndi:BPMNShape id="Shape_userTask_Image15_2" bpmnElement="userTask_Image15_2"><dc:Bounds x="500" y="180" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Image15" bpmnElement="End_Image15"><dc:Bounds x="670" y="202" width="36" height="36"/></bpmndi:BPMNShape>
