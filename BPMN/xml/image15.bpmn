    <bpmn:incoming>Flow_Image15_1</bpmn:incoming>
    <bpmn:outgoing>Flow_Image15_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Image15" name="task completed">
    <bpmn:incoming>Flow_Image15_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Image15_0" sourceRef="Start_Image15" targetRef="businessRuleTask_Image15_1" />
    <bpmn:sequenceFlow id="Flow_Image15_1" sourceRef="businessRuleTask_Image15_1" targetRef="userTask_Image15_2" />
    <bpmn:sequenceFlow id="Flow_Image15_2" sourceRef="userTask_Image15_2" targetRef="End_Image15" />
  </bpmn:process>
