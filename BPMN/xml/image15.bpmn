  <bpmn:process id="Process_Image15" name="Reassign - rules" isExecutable="true">
    <bpmn:startEvent id="Start_Image15" name="some user task started">
    <bpmn:outgoing>Flow_Image15_0</bpmn:outgoing>
    </bpmn:startEvent>
