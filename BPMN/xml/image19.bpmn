      <bpmndi:BPMNEdge id="Edge_Flow_Image19_1" bpmnElement="Flow_Image19_1"><di:waypoint x="470" y="220"/><di:waypoint x="500" y="220"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Image19_2" bpmnElement="Flow_Image19_2"><di:waypoint x="640" y="220"/><di:waypoint x="670" y="220"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Image19_3" bpmnElement="Flow_Image19_3"><di:waypoint x="810" y="220"/><di:waypoint x="840" y="220"/></bpmndi:BPMNEdge>
