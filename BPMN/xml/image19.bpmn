      <bpmndi:BPMNShape id="Shape_userTask_Image19_1" bpmnElement="userTask_Image19_1"><dc:Bounds x="330" y="180" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_exclusiveGateway_Image19_2" bpmnElement="exclusiveGateway_Image19_2" isMarkerVisible="true"><dc:Bounds x="500" y="195" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_userTask_Image19_3" bpmnElement="userTask_Image19_3"><dc:Bounds x="670" y="180" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Image19" bpmnElement="End_Image19"><dc:Bounds x="840" y="202" width="36" height="36"/></bpmndi:BPMNShape>
