    <bpmn:sequenceFlow id="Flow_Image8_3" sourceRef="exclusiveGateway_Image8_3" targetRef="userTask_Image8_4" />
    <bpmn:sequenceFlow id="Flow_Image8_4" sourceRef="userTask_Image8_4" targetRef="End_Image8" />
  </bpmn:process>
