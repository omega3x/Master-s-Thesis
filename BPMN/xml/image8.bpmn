    <bpmn:incoming>Flow_Image8_2</bpmn:incoming>
    <bpmn:outgoing>Flow_Image8_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="userTask_Image8_4" name="decide on approval (2nd stage)">
    <bpmn:incoming>Flow_Image8_3</bpmn:incoming>
    <bpmn:outgoing>Flow_Image8_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Image8" name="request approved">
    <bpmn:incoming>Flow_Image8_4</bpmn:incoming>
    </bpmn:endEvent>
