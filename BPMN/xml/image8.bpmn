  <bpmn:process id="Process_Image8" name="Four Eyes - LDAP" isExecutable="true">
    <bpmn:startEvent id="Start_Image8" name="Approval requested">
    <bpmn:outgoing>Flow_Image8_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="serviceTask_Image8_1" name="determine 1st and 2nd approver">
    <bpmn:incoming>Flow_Image8_0</bpmn:incoming>
    <bpmn:outgoing>Flow_Image8_1</bpmn:outgoing>
    </bpmn:serviceTask>
