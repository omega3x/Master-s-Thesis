      <bpmndi:BPMNEdge id="Edge_Flow_Image1_1" bpmnElement="Flow_Image1_1"><di:waypoint x="470" y="220"/><di:waypoint x="500" y="220"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Image1_2" bpmnElement="Flow_Image1_2"><di:waypoint x="640" y="220"/><di:waypoint x="670" y="220"/></bpmndi:BPMNEdge>
