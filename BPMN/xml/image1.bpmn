      <bpmndi:BPMNShape id="Shape_businessRuleTask_Image1_2" bpmnElement="businessRuleTask_Image1_2"><dc:Bounds x="500" y="180" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_userTask_Image1_3" bpmnElement="userTask_Image1_3"><dc:Bounds x="670" y="180" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Image1" bpmnElement="End_Image1"><dc:Bounds x="840" y="202" width="36" height="36"/></bpmndi:BPMNShape>
