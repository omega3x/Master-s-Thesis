  <bpmn:process id="Process_Image4" name="Dependent Instances - Message" isExecutable="true">
    <bpmn:startEvent id="Start_Image4" name="Check requested">
    <bpmn:outgoing>Flow_Image4_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="serviceTask_Image4_1" name="check for running instances">
    <bpmn:incoming>Flow_Image4_0</bpmn:incoming>
    <bpmn:outgoing>Flow_Image4_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="exclusiveGateway_Image4_2" name="running instances?">
    <bpmn:incoming>Flow_Image4_1</bpmn:incoming>
    <bpmn:outgoing>Flow_Image4_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="serviceTask_Image4_3" name="perform credit check">
    <bpmn:incoming>Flow_Image4_2</bpmn:incoming>
    <bpmn:outgoing>Flow_Image4_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="serviceTask_Image4_4" name="inform waiting instance">
    <bpmn:incoming>Flow_Image4_3</bpmn:incoming>
    <bpmn:outgoing>Flow_Image4_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Image4" name="credit check performed">
    <bpmn:incoming>Flow_Image4_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Image4_0" sourceRef="Start_Image4" targetRef="serviceTask_Image4_1" />
