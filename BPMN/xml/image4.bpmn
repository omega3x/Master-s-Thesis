    <bpmn:sequenceFlow id="Flow_Image4_2" sourceRef="exclusiveGateway_Image4_2" targetRef="serviceTask_Image4_3" />
    <bpmn:sequenceFlow id="Flow_Image4_3" sourceRef="serviceTask_Image4_3" targetRef="serviceTask_Image4_4" />
    <bpmn:sequenceFlow id="Flow_Image4_4" sourceRef="serviceTask_Image4_4" targetRef="End_Image4" />
  </bpmn:process>
